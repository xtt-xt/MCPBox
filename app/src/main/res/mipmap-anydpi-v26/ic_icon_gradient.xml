<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标（可切换）：gradient。
  图案画在 background 层（[ic_bg_gradient]，已缩到中心 72dp 安全区），前景是空白矢量占位 ——
  自适应图标的遮罩（圆形 / 方圆 / 圆角矩形）就是最终形状。
  ⚠️ 前景**不能**写 @android:color/transparent：那是个颜色资源，不是 drawable，
  整张图标会加载失败、桌面退回系统默认图。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_bg_gradient" />
    <foreground android:drawable="@drawable/ic_icon_blank" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
