<?xml version="1.0" encoding="utf-8"?>
<!--
  「抽屉」这套图标的自适应图标底图。

  为什么要 inset：adaptive icon 是 108dp 的图层，启动器只显示**中心 72dp**
  （四周 18dp 留作遮罩动画）。整张图直接铺满 108 的话，可见区里只剩图案的中间那段、
  等于把图案放大 1.5 倍（桌面图标顶满、和设计稿差得远）。

  这一套单独用 15dp：抽屉那张设计稿里图形只占画布 46%（别的 60% 左右），
  同样按 18dp 缩进桌面会显得比其他图标小一圈，所以比别的多露出 6dp。
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/art_icon_drawer"
    android:insetLeft="15dp"
    android:insetTop="15dp"
    android:insetRight="15dp"
    android:insetBottom="15dp" />
