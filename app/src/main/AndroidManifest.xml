<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 前台服务：让服务器一直活着，直到用户主动关闭 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- 悬浮窗：审批弹窗显示在最上层 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 文件访问权限 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!--
        明文 HTTP（http://）：
        targetSdk 28 起系统默认禁止明文流量，表现是内置浏览器打开 http:// 页面直接报
        net::ERR_CLEARTEXT_NOT_PERMITTED（连「允许访问内网」打开也救不了）。
        浏览器就该和普通浏览器一样能开 http 站点，所以这里全局放开；
        内网 / 本机地址仍由 Browser.kt 的 AllowLan 开关拦截，不受这里影响。
    -->
    <application
        android:name=".MCPBoxApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.MCPBox"
        android:enableOnBackInvokedCallback="true">

        <!--
            主界面。**故意不带 MAIN/LAUNCHER**：桌面图标由下面那组 activity-alias 提供
            （每个 alias 一种图标，切换＝把目标 alias 设成 ENABLED、其余 DISABLED，见 ui/AppIcon.kt）。
            带在这里的话桌面上会同时出现两个图标。
            `am start -n com.xtt.mcpbox/.ui.MainActivity` 这种显式组件启动不受影响。
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- 桌面图标 · 线性极简（默认） -->
        <activity-alias
            android:name=".ui.IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_icon_line"
            android:roundIcon="@mipmap/ic_icon_line"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 桌面图标 · 扁平 -->
        <activity-alias
            android:name=".ui.IconFlat"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_flat"
            android:roundIcon="@mipmap/ic_icon_flat"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 桌面图标 · 渐变 -->
        <activity-alias
            android:name=".ui.IconGradient"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_gradient"
            android:roundIcon="@mipmap/ic_icon_gradient"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 桌面图标 · 液体玻璃 -->
        <activity-alias
            android:name=".ui.IconGlass"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_glass"
            android:roundIcon="@mipmap/ic_icon_glass"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 桌面图标 · 暗色玻璃 -->
        <activity-alias
            android:name=".ui.IconDarkGlass"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_darkglass"
            android:roundIcon="@mipmap/ic_icon_darkglass"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 桌面图标 · 新拟物 -->
        <activity-alias
            android:name=".ui.IconSoft"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_soft"
            android:roundIcon="@mipmap/ic_icon_soft"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 桌面图标 · 档案抽屉（D 拉出式） -->
        <activity-alias
            android:name=".ui.IconDrawer"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_drawer"
            android:roundIcon="@mipmap/ic_icon_drawer"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".server.McpService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local MCP file server for AI clients on the same device or LAN" />
        </service>

        <receiver
            android:name=".server.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".server.ApprovalActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Shizuku：接收它的 binder，才能用 shell 身份执行命令 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
